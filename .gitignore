# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
localize-*.tar

# mise and asdf
mise.toml
.tool-versions

# object files
*.so
*.o

# Raw CLDR sources copied in by mix localize.copy_sources. Build input only —
# never shipped in the hex package, and nothing under lib/ reads it — though
# the test suite does, so a full `mix test` needs it present. Tracking it cost
# roughly 14 MB of pack per regeneration, and a CLDR cycle regenerates many
# times, so it is reproduced locally instead:
#
#   CLDR_TAG=release-<N> scripts/build_cldr_production_data
#   mix localize.copy_sources
#
# See CLDR_UPDATE_INTEGRATION.md.
/priv/cldr/

# Generated locale ETF files (populated via mix localize.generate_locales).
# The trailing `/*` matters: excluding the directory itself stops git
# descending into it, and a negation cannot re-include a file whose parent
# directory is excluded, so `en.etf` and `und.etf` stayed ignored.
/priv/localize/locales/*
!/priv/localize/locales/en.etf
!/priv/localize/locales/und.etf

# Inflection source data from unicode-org/inflection. Never vendored: the
# commit it comes from is pinned in priv/localize/localize_inflection_sha,
# and mix localize.inflection.download fetches every file at that commit.
# Only the test/ conformance fixtures are tracked; add new ones with
# `git add -f`.
/data/inflection/

# Generated inflection ETFs (mix localize.inflection.generate). Like the
# locale ETFs, consumers download them at runtime and verify them against
# priv/localize/inflection_hashes.etf, which is tracked.
/priv/localize/inflection/

# Experiment files
bench_unit_parser.sh

# Generated erl files
/src/*.erl

# Claude
CLAUDE.md
.claude/

# private
r2_setup.md

.DS_Store
dont_sleep
